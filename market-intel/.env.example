# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
#
# The core price/volume collector needs NO keys. These are only used by
# later layers (LLM narrative, richer news/earnings sources).

# Anthropic API key — for the LLM narrative layer (report writing).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub free-tier key — optional, for earnings calendar & analyst ratings.
# Get one at https://finnhub.io
FINNHUB_API_KEY=

# Email delivery (optional). If these are unset, `--method email` becomes a
# safe no-op dry run instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
REPORT_FROM=
REPORT_TO=            # comma-separated for multiple recipients
